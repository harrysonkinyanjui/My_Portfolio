<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Harrison Kinyanjui | IT Portfolio</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <header>
    <nav class="container">
      <h1 class="logo">HK.</h1>
      <ul class="nav-links">
        <li><a href="#about">About</a></li>
        <li><a href="#skills">Skills</a></li>
        <li><a href="#projects">Projects</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
      <button id="theme-toggle" aria-label="Toggle Dark Mode">🌙</button>
    </nav>
  </header>

  <main>
    <!-- Hero Section -->
    <section id="hero" class="container">
      <p class="greeting">Hello, I'm</p>
      <h2>Harrison Kinyanjui</h2>
      <h3>Second-Year IT Student at Kinyaga University</h3>
      <p class="bio">
        Passionate about web development, networking architectures, and building practical software solutions from the ground up.
      </p>
      <div class="hero-buttons">
        <a href="#projects" class="btn primary">View Projects</a>
        <a href="#contact" class="btn secondary">Get In Touch</a>
      </div>
    </section>

    <!-- About Section -->
    <section id="about" class="container section">
      <h2 class="section-title">About Me</h2>
      <p>
        I am currently pursuing my Bachelor's degree in Information Technology at Kinyaga University (2nd Year). 
        My academic and personal focus revolves around full-stack web fundamentals, Linux system administration, 
        local network configuration, and writing clean, efficient code.
      </p>
    </section>

    <!-- Skills Section -->
    <section id="skills" class="container section">
      <h2 class="section-title">Technical Skills</h2>
      <div class="skills-grid">
        <div class="skill-card">HTML5 & Semantic Markup</div>
        <div class="skill-card">CSS3, Flexbox & Grid</div>
        <div class="skill-card">JavaScript (ES6+ & DOM)</div>
        <div class="skill-card">Linux CLI & Administration</div>
        <div class="skill-card">Networking & Routing</div>
        <div class="skill-card">Git & VS Code</div>
      </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="container section">
      <h2 class="section-title">Projects</h2>
      <div class="projects-grid">
        <div class="project-card">
          <h3>Student Registration Portal</h3>
          <p>Interactive web form with real-time DOM validation, dynamic counters, and theme switching built using vanilla JS.</p>
          <span class="tag">HTML</span> <span class="tag">CSS</span> <span class="tag">JS</span>
        </div>
        <div class="project-card">
          <h3>Number System Converter</h3>
          <p>Utility tool for converting values across Binary, Octal, Decimal, and Hexadecimal bases with step-by-step logic.</p>
          <span class="tag">JavaScript</span> <span class="tag">Algorithms</span>
        </div>
        <div class="project-card">
          <h3>Local Network Hotspot Setup</h3>
          <p>Configured local wireless/wired routing infrastructure and automated Linux command-line hotspot deployment.</p>
          <span class="tag">Linux</span> <span class="tag">Networking</span>
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="container section">
      <h2 class="section-title">Contact Me</h2>
      <form id="contact-form">
        <input type="text" id="name" placeholder="Your Name" required>
        <input type="email" id="email" placeholder="Your Email" required>
        <textarea id="message" rows="4" placeholder="Your Message" required></textarea>
        <button type="submit" class="btn primary">Send Message</button>
        <p id="form-status" class="status-msg"></p>
      </form>
    </section>
  </main>

  <footer>
    <p>&copy; <span id="year"></span> Harrison Kinyanjui. All rights reserved.</p>
  </footer>

  <script src="script.js"></script>
</body>
</html>

